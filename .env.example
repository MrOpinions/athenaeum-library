# Copy to .env and edit. run.ps1 reads these lines; nothing here is committed.
LMS_DB_HOST=127.0.0.1
LMS_DB_PORT=3306
LMS_DB_USER=root
LMS_DB_PASSWORD=
LMS_DB_NAME=library_ms
LMS_PORT=8080
# 127.0.0.1 = this computer only. Use 0.0.0.0 to let friends on your Wi-Fi/LAN open it.
LMS_HOST=127.0.0.1
# set to 0 to skip loading the demo data
LMS_SEED=1
